# ── Database (MariaDB existing server sekolah) ───────────────────
# user lms_user hanya punya grant ke smp_lms (pola mpi_user). Lihat deploy/db.sql.
DATABASE_URL="mysql://lms_user:GANTI_PASSWORD@127.0.0.1:3306/smp_lms"

# ── Runtime ───────────────────────────────────────────────────────
# Port 3000 sudah dipakai presensi; LMS di 3005 (PRD §2A B1)
PORT=3005
HOST=127.0.0.1
NODE_ENV=production

# ── Auth ──────────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="GANTI_DENGAN_HEX_RAHASIA_64"

# ── Bootstrap migrasi (scripts/bootstrap.mjs, sekali di awal) ─────
BOOTSTRAP_SQLITE_PATH="/var/www/presensi/data/sekolah.db"
# Read-only ke DB CBT utk akun NISN/guru/kelas. RUNBOOK: grant SELECT sementara.
CBT_DATABASE_URL="mysql://lms_user:GANTI_PASSWORD@127.0.0.1:3306/cbt_tka"

# ── Konfigurasi sekolah ───────────────────────────────────────────
SCHOOL_NAME="SMP Negeri 5 Tegal"
SCHOOL_ACADEMIC_YEAR="2026/2027"
SCHOOL_SEMESTER_NUMBER=1
