# /etc/systemd/system/lms.service — LMS SMPN 5 Tegal
# Sesuaikan User/Group & path node bila perlu (which node).
[Unit]
Description=LMS SMP Negeri 5 Tegal (Next.js standalone, port 3005)
After=network.target mariadb.service
Wants=mariadb.service

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/var/www/lms
EnvironmentFile=/var/www/lms/.env
# PRD §2.1: batasi memory Node di server 8 GB (runtime-only, tanpa build)
ExecStart=/usr/bin/node --max-old-space-size=768 server.js
Restart=on-failure
RestartSec=5
# keamanan dasar
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
