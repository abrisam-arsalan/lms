{
  "version": 3,
  "pages404": true,
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [
    {
      "page": "/api/file/[id]",
      "regex": "^/api/file/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/api/file/(?<nxtPid>[^/]+?)(?:/)?$"
    },
    {
      "page": "/tp/[assignmentId]",
      "regex": "^/tp/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPassignmentId": "nxtPassignmentId"
      },
      "namedRegex": "^/tp/(?<nxtPassignmentId>[^/]+?)(?:/)?$"
    }
  ],
  "staticRoutes": [
    {
      "page": "/",
      "regex": "^/(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/(?:/)?$"
    },
    {
      "page": "/_not-found",
      "regex": "^/_not\\-found(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_not\\-found(?:/)?$"
    },
    {
      "page": "/admin/users",
      "regex": "^/admin/users(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/admin/users(?:/)?$"
    },
    {
      "page": "/dashboard",
      "regex": "^/dashboard(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/dashboard(?:/)?$"
    },
    {
      "page": "/healthz",
      "regex": "^/healthz(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/healthz(?:/)?$"
    },
    {
      "page": "/jadwal",
      "regex": "^/jadwal(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/jadwal(?:/)?$"
    },
    {
      "page": "/login",
      "regex": "^/login(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/login(?:/)?$"
    },
    {
      "page": "/materi",
      "regex": "^/materi(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/materi(?:/)?$"
    },
    {
      "page": "/nilai",
      "regex": "^/nilai(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/nilai(?:/)?$"
    },
    {
      "page": "/pengumuman",
      "regex": "^/pengumuman(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/pengumuman(?:/)?$"
    },
    {
      "page": "/tp",
      "regex": "^/tp(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/tp(?:/)?$"
    },
    {
      "page": "/tugas",
      "regex": "^/tugas(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/tugas(?:/)?$"
    }
  ],
  "dataRoutes": [],
  "rsc": {
    "header": "rsc",
    "varyHeader": "rsc, next-router-state-tree, next-router-prefetch, next-router-segment-prefetch",
    "prefetchHeader": "next-router-prefetch",
    "didPostponeHeader": "x-nextjs-postponed",
    "contentTypeHeader": "text/x-component",
    "suffix": ".rsc",
    "prefetchSuffix": ".prefetch.rsc",
    "prefetchSegmentHeader": "next-router-segment-prefetch",
    "prefetchSegmentSuffix": ".segment.rsc",
    "prefetchSegmentDirSuffix": ".segments"
  },
  "rewriteHeaders": {
    "pathHeader": "x-nextjs-rewritten-path",
    "queryHeader": "x-nextjs-rewritten-query"
  }
}